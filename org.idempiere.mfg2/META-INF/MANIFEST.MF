 zul;bundle-version="10.3.0",
 wrapped.org.jfree.jfreechart;bundle-version="1.0.19",
 org.osgi.service.event;bundle-version="1.4.1",
 wrapped.org.jfree.jcommon;bundle-version="1.0.24"
